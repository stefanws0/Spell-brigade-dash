<Project Sdk="Microsoft.NET.Sdk">
  <!--
    COMPILE-CHECK STUB ONLY. Stands in for the game's Runtime interop assembly (where The Spell Brigade's own classes
    live, in the global namespace) plus the bits of Unity.Netcode and Unity.Localization the mod uses with real types.
    Only the members the mod uses. Never shipped (a DLL built against stubs does not run in the game).
  -->
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>Runtime</AssemblyName>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);CS0660;CS0661;CS8618;CS0108</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(BepInExCore)\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepInExCore)\Il2CppInterop.Common.dll" Private="false" />
    <ProjectReference Include="..\UnityEngine.CoreModule\UnityEngine.CoreModule.csproj" />
  </ItemGroup>
</Project>
