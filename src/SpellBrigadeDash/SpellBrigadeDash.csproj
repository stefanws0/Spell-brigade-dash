<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>SpellBrigadeDash</AssemblyName>
    <RootNamespace>SpellBrigadeDash</RootNamespace>
    <Version>0.2.0</Version>
    <!-- C# 10: newer versions emit extra compiler attributes (RefSafetyRules) that could clash with interop copies. -->
    <LangVersion>10</LangVersion>
    <!-- See CompilerAttributes.cs: the mod ships its own NullableAttribute because the game's interop exposes a broken one. -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType>embedded</DebugType>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Interop assemblies are generated per game, so version mismatches between them are expected. -->
    <NoWarn>$(NoWarn);MSB3277;CS1591;CS0436</NoWarn>
  </PropertyGroup>

  <!--
    Where BepInEx (installed and started once, so interop/ exists) lives. First match wins:
      1. BepInExDir / GameDir from GamePaths.props.user (copy GamePaths.props.user.example) or the command line
      2. this repo sitting inside a BepInEx folder (e.g. ...\profiles\Default\BepInEx\<repo>)
      3. r2modman's default profile:  %APPDATA%\r2modmanPlus-local\TheSpellBrigade\profiles\Default\BepInEx
      4. a plain Steam install:        C:\Program Files (x86)\Steam\steamapps\common\The Spell Brigade\BepInEx
  -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\GamePaths.props.user" Condition="Exists('$(MSBuildThisFileDirectory)..\..\GamePaths.props.user')" />
  <PropertyGroup>
    <_RepoParentDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..'))</_RepoParentDir>
    <_R2ModmanBepInEx>$(APPDATA)\r2modmanPlus-local\TheSpellBrigade\profiles\Default\BepInEx</_R2ModmanBepInEx>
    <BepInExDir Condition="'$(BepInExDir)' == '' And '$(GameDir)' == '' And Exists('$(_RepoParentDir)\core\BepInEx.Unity.IL2CPP.dll')">$(_RepoParentDir)</BepInExDir>
    <BepInExDir Condition="'$(BepInExDir)' == '' And '$(GameDir)' == '' And '$(APPDATA)' != '' And Exists('$(_R2ModmanBepInEx)\core\BepInEx.Unity.IL2CPP.dll')">$(_R2ModmanBepInEx)</BepInExDir>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\The Spell Brigade</GameDir>
    <BepInExDir Condition="'$(BepInExDir)' == ''">$(GameDir)\BepInEx</BepInExDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(BepInExDir)\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\0Harmony.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\Il2CppInterop.Common.dll" Private="false" />
    <!-- Every interop assembly BepInEx generated for the game (UnityEngine.*, Unity.InputSystem, Il2Cppmscorlib, Assembly-CSharp, ...) -->
    <Reference Include="$(BepInExDir)\interop\*.dll" Private="false" />
  </ItemGroup>

  <Target Name="CheckGamePaths" BeforeTargets="ResolveAssemblyReferences">
    <Message Importance="high" Text="Using BepInEx at: $(BepInExDir)" />
    <Error Condition="!Exists('$(BepInExDir)\core\BepInEx.Unity.IL2CPP.dll')"
           Text="BepInEx not found at '$(BepInExDir)'. Install BepInExPack_IL2CPP into the game (or set BepInExDir to your r2modman/Gale profile's BepInEx folder) - see README.md." />
    <Error Condition="!Exists('$(BepInExDir)\interop\UnityEngine.CoreModule.dll')"
           Text="No interop assemblies in '$(BepInExDir)\interop'. Start the game once with BepInEx installed so it generates them, then build again." />
  </Target>

  <!-- dotnet build -p:DeployToGame=true  → copies the DLL straight into BepInEx/plugins -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExDir)\plugins\SpellBrigadeDash" />
    <Message Importance="high" Text="Deployed to $(BepInExDir)\plugins\SpellBrigadeDash" />
  </Target>

  <!-- dotnet build -c Release -t:Package  → dist/SpellBrigadeDash-<version>.zip, ready for r2modman/Gale/Thunderstore -->
  <Target Name="Package" DependsOnTargets="Build">
    <PropertyGroup>
      <RepoRoot>$(MSBuildThisFileDirectory)..\..\</RepoRoot>
      <StageDir>$(BaseIntermediateOutputPath)package\</StageDir>
      <DistDir>$(RepoRoot)dist\</DistDir>
    </PropertyGroup>
    <RemoveDir Directories="$(StageDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(StageDir)" />
    <Copy SourceFiles="$(RepoRoot)thunderstore\manifest.json;$(RepoRoot)thunderstore\icon.png;$(RepoRoot)thunderstore\README.md;$(RepoRoot)CHANGELOG.md" DestinationFolder="$(StageDir)" />
    <MakeDir Directories="$(DistDir)" />
    <ZipDirectory SourceDirectory="$(StageDir)" DestinationFile="$(DistDir)SpellBrigadeDash-$(Version).zip" Overwrite="true" />
    <Message Importance="high" Text="Package: $(DistDir)SpellBrigadeDash-$(Version).zip" />
  </Target>

</Project>
